NG_APP_API_URL="http://localhost:8081/api/v1"
NG_APP_GRAPHQL_URL="http://localhost:8081/graphql/v1"
NG_APP_AUTHENTICATION_AUTHORITY="http://localhost:8080/realms/openfilz"
NG_APP_AUTHENTICATION_CLIENT_ID="openfilz-web"
NG_APP_AUTHENTICATION_ENABLED="true"
NG_APP_ONLYOFFICE_ENABLED="true"
NG_APP_ONLYOFFICE_MAX_FILE_SIZE="30"
NG_APP_STORAGE_MINIO_VERSIONING_ENABLED="false"

# Where roles are read from the access token — must mirror the API's
# OPENFILZ_SECURITY_ROLE_TOKEN_LOOKUP / OPENFILZ_SECURITY_ROOT_GROUP.
# REALM_ACCESS (default) = realm_access.roles; GROUPS = only groups /<NG_APP_ROOT_GROUP>/<ROLE>.
# Must be DEFINED (even empty) so @ngx-env/builder rewrites the import.meta.env access.
NG_APP_ROLE_TOKEN_LOOKUP=""
NG_APP_ROOT_GROUP=""
